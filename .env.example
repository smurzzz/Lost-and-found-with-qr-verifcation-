# Supabase — Project Settings → API
# Project URL, e.g. https://abcdefgh.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# anon / public key (safe for client-side use; RLS still applies)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk — Dashboard → API Keys → Publishable key (pk_test_... / pk_live_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ⚠️ NEVER put the Supabase service-role key in this file.
# It belongs only in Supabase Edge Function secrets:
#   npx supabase secrets set SERVICE_ROLE_KEY=...
# See 06-LIBRARY-DOCS.md "Environment variables required".
